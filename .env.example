# Copia este archivo a .env.local y rellena los valores desde
# Supabase → Project Settings → API. NO subas .env.local a git.

# URL del proyecto Supabase (Project Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública "anon" (Project Settings → API → anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave privada "service_role" — solo para scripts de servidor/admin.
# NUNCA se expone al navegador. (Project Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=

# URL base de la app (en local: http://localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
